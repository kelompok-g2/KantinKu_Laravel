{
  "info": {
    "name": "KantinKu Kelompok G2 - Pertemuan 9",
    "description": "Jalankan berurutan di database demo. Pilih environment P09 Local dan isi demo_password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const payload = pm.response.json();",
          "pm.test(\"Kontrak JSON\", () => { const status = pm.response.code < 400 ? \"success\" : \"error\"; pm.expect(payload).to.include.keys(\"status\", \"message\", \"data\"); pm.expect(payload.status).to.eql(status); pm.expect(payload.message).to.be.a(\"string\"); });",
          "pm.test(\"Field rahasia disembunyikan\", () => pm.expect(JSON.stringify(payload)).not.to.match(/\"(?:password|password_confirmation|remember_token|checkout_token|access_token)\"/i));"
        ]
      }
    }
  ],
