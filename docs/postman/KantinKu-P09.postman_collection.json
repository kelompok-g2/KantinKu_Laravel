        {
          "name": "Register pelanggan",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"buyer_email\", \"p09-postman-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Token diterbitkan\", () => pm.expect(payload.data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"buyer_token\", payload.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman P09\",\n  \"email\": \"{{buyer_email}}\",\n  \"password\": \"{{demo_password}}\",\n  \"password_confirmation\": \"{{demo_password}}\"\n}",
